# Production environment — the ONE source of truth for the environment-specific
# values that provision-staging.sh, setup-wif.sh, provision-observability.sh and
# .github/workflows/deploy-prod.yml need. Sibling of staging.env (OFC-84); the
# scripts select it with `ENV_FILE=infra/environments/prod.env`.
#
# Format rules (so BOTH consumers stay happy): plain KEY=value, no quotes, no
# spaces around `=`, no spaces in values. Comments/blanks are ignored.
#
# ⚠ Production holds REAL member PII and writes to the LIVE Ghost site. There are
# deliberately NO seeding, mirroring or tester-provisioning values here — the
# deploy workflow has no such steps, and the fake-data seeders refuse a project
# id that does not end in "-staging" (D72). The one bulk write into production
# is the operator-run genesis load (docs/initial-build/CUTOVER-PLAN.md).

# Project + region
PROJECT_ID=pbe-book-prod
REGION=us-central1

# Cloud Run service + its runtime service account (D83 scale-to-zero, one instance)
SERVICE=pbe-book-api
SA_NAME=book-api
RUNTIME_SA=book-api@pbe-book-prod.iam.gserviceaccount.com

# Private member-image bucket (D126 — app-served, no CDN/LB)
IMAGE_BUCKET=pbe-book-prod-images

# Keyless CI deploy identity (setup-wif.sh) — none of these are secrets.
# 464611847104 is the pbe-book-prod project NUMBER.
GITHUB_REPO=fthiess/pbe-address-book
DEPLOYER_SA=github-deployer@pbe-book-prod.iam.gserviceaccount.com
WIF_PROVIDER=projects/464611847104/locations/global/workloadIdentityPools/github-pool/providers/github-provider

# Automated twice-daily backup (D63/D101/D149; CUTOVER-PLAN). See staging.env for
# why BACKUP_AUDIENCE is a fixed logical string and why BACKUP_INVOKER_SUBJECT is
# the scheduler service account's NUMERIC unique id (its email will not work).
# provision-staging.sh prints the live value; a stale one here ships a service
# that rejects every scheduler token and the backup stops silently. Read it with:
#   gcloud iam service-accounts describe \
#     book-backup-scheduler@pbe-book-prod.iam.gserviceaccount.com \
#     --format='value(uniqueId)'
BACKUP_BUCKET=pbe-book-prod-backups
BACKUP_AUDIENCE=https://pbe-book-prod.example/api/internal/backup
BACKUP_INVOKER_SUBJECT=105313162289715075805

# Ghost auth bridge — the LIVE newsletter site, pbe400.org (Ghost Pro). The
# bridge route /book/ is served by the pbe-news-ghost-theme; `target=prod`
# selects book.pbe400.org from the theme's hardcoded callback allowlist (D104).
GHOST_JWKS_URL=https://pbe400.org/members/.well-known/jwks.json
GHOST_JWT_ISSUER=https://pbe400.org/members/api
GHOST_JWT_AUDIENCE=https://pbe400.org/members/api
GHOST_BRIDGE_URL=https://pbe400.org/book
GHOST_BRIDGE_TARGET=prod

# Ghost Admin API (write path). The KEY lives in Secret Manager (secret
# `ghost-admin-api-key`) and rides via --set-secrets. Ghost Pro serves the Admin
# API on the ghost.io hostname. GHOST_NEWSLETTER_ID is the live "PBE News"
# newsletter (read from /newsletters/ on 2026-09-15).
GHOST_ADMIN_API_URL=https://pbe-news.ghost.io/ghost/api/admin
GHOST_NEWSLETTER_ID=68d57c27c748260008d75544

# The sibling newsletter URL the SPA's masthead "PBE News" link points at (N94).
BOOK_PBE_NEWS_URL=https://pbe400.org

# Observability (provision-observability.sh): where Cloud Monitoring emails the
# sign-in-denial-burst and backup-absence alerts. Display names override the
# script's "(staging)" defaults so the production console is labelled honestly.
ALERT_EMAIL=fthiess@gmail.com
ALERT_CHANNEL_NAME=book-alerts-prod
DENIAL_POLICY_NAME=book-signin-denial-burst-prod
BACKUP_POLICY_NAME=book-backup-problem-prod
BACKUP_ABSENT_POLICY_NAME=book-backup-absent-prod

# The Mixpanel project token for the production tier (D138/D139): the SAME
# project the newsletter already reports to, joined by the Ghost member uuid and
# discriminated by the `app` super property. A token is a publishable
# client-side identifier, not a secret. Injected into the web build via
# $GITHUB_ENV (vite.config reads BOOK_MIXPANEL_TOKEN).
BOOK_MIXPANEL_TOKEN=8216a6e8bddb2f3f4c07409477afbc73
