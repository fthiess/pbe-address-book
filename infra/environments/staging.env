# Staging environment — the ONE source of truth for the environment-specific
# values that provision-staging.sh, setup-wif.sh, and .github/workflows/
# deploy-staging.yml all need (OFC-84). Previously each hardcoded these
# independently, and a drift between them had to be hand-fixed across three files.
#
# Consumed two ways, both of which tolerate these comments:
#   - the shell scripts `source` this file (their ${VAR:-default} still applies);
#   - the deploy workflow appends the KEY=VALUE lines to $GITHUB_ENV.
#
# Format rules (so BOTH consumers stay happy): plain KEY=VALUE, one per line, no
# quotes, no spaces around `=`, no spaces in values. Comments/blanks are ignored.
# A prod environment gets a sibling prod.env with the pbe400.org / prod values.

# Project + region
PROJECT_ID=pbe-book-staging
REGION=us-central1

# Cloud Run service + its runtime service account (D83 scale-to-zero, one instance)
SERVICE=pbe-book-api
SA_NAME=book-api
RUNTIME_SA=book-api@pbe-book-staging.iam.gserviceaccount.com

# Private member-image bucket (D126 — app-served, no CDN/LB)
IMAGE_BUCKET=pbe-book-staging-images

# Private UAT fixtures bucket (Stage 1.2; OFC-248/OFC-249). Holds two things that
# must never enter this PUBLIC repo: the prepared UAT photo corpus, and the tester
# roster CSV — which carries real brothers' names and email addresses.
#
# ⚠ It is a SEPARATE bucket from IMAGE_BUCKET on purpose. The Book runtime service
# account holds objectAdmin on the image bucket, so a roster of real member PII
# parked there would sit inside the running application's blast radius. This bucket
# grants the runtime SA nothing at all; only the CI deployer reads it. Do not
# "simplify" it into a prefix on the image bucket.
#
# The bucket NAME is not a secret — access is IAM-controlled and public access is
# prevented — so it belongs here with the rest of the environment.
UAT_FIXTURES_BUCKET=pbe-book-staging-uat

# The UAT tester roster (Stage 1.2; OFC-248/D156) — the CSV `seed:staging-testers`
# reads to provision the cohort. The URI is not a secret; its CONTENTS are (real
# brothers' names and email addresses), which is why the object lives in the private
# bucket above and the tool logs ids and counts only, never names.
#
# Unset this line to skip tester provisioning entirely: the deploy step is gated on
# it, so an environment with no roster simply seeds fake data and stops.
UAT_ROSTER_URI=gs://pbe-book-staging-uat/roster/uat-testers.csv

# Keyless CI deploy identity (setup-wif.sh) — none of these are secrets
GITHUB_REPO=fthiess/pbe-address-book
DEPLOYER_SA=github-deployer@pbe-book-staging.iam.gserviceaccount.com
WIF_PROVIDER=projects/268373129203/locations/global/workloadIdentityPools/github-pool/providers/github-provider

# Automated daily backup (D63/D101/D102; 7b-2, OFC-327). The ACL-restricted bucket
# the nightly snapshot is written to, and the two halves of the Cloud Scheduler
# identity Book pins. None of these is a secret.
#
# BACKUP_AUDIENCE is a deliberately FIXED logical string, not the Cloud Run URL:
# the URL is not known until the service is deployed, but the deploy needs this
# value in its environment. Book verifies the `aud` claim itself, so nothing
# requires it to resolve to a real address — it only has to match on both sides.
#
# ⚠ BACKUP_INVOKER_SUBJECT is the scheduler service account's NUMERIC UNIQUE ID —
# that is what Google puts in an OIDC token's `sub`. Its EMAIL will not work.
# provision-staging.sh derives the live value, uses it for its own deploy, and
# warns loudly if this line disagrees; the GitHub deploy workflow cannot run gcloud
# and trusts this line alone, so a stale value here means the next CI deploy ships
# a service that rejects every scheduler token and the backup stops silently.
# Read it with:
#   gcloud iam service-accounts describe \
#     book-backup-scheduler@pbe-book-staging.iam.gserviceaccount.com \
#     --format='value(uniqueId)'
BACKUP_BUCKET=pbe-book-staging-backups
BACKUP_AUDIENCE=https://pbe-book-staging.example/api/internal/backup
BACKUP_INVOKER_SUBJECT=115810403325998467773

# Ghost auth bridge (Phase 1b) — self-hosted ghost-staging (D72, amended)
GHOST_JWKS_URL=https://staging.pbe400.org/members/.well-known/jwks.json
GHOST_JWT_ISSUER=https://staging.pbe400.org/members/api
GHOST_JWT_AUDIENCE=https://staging.pbe400.org/members/api
GHOST_BRIDGE_URL=https://staging.pbe400.org/book
GHOST_BRIDGE_TARGET=staging

# Ghost Admin API (Phase 5b-1 write path). The KEY is NOT here — it lives in Secret
# Manager (secret `ghost-admin-api-key`) and is referenced by the Cloud Run deploy
# via --set-secrets. These two are non-secret. GHOST_NEWSLETTER_ID is ghost-staging's
# "PBE News (Staging)" newsletter (must-verify N67, confirmed live).
GHOST_ADMIN_API_URL=https://staging.pbe400.org/ghost/api/admin
GHOST_NEWSLETTER_ID=6a3ebdd8415f8e0001858cb0

# The sibling newsletter URL the SPA's masthead "PBE News" link points at (OFC-243/
# N94). Injected into the web build via $GITHUB_ENV (vite.config reads
# BOOK_PBE_NEWS_URL). Staging points at ghost-staging; a prod.env would set the
# pbe400.org value, and an unset build defaults to pbe400.org.
BOOK_PBE_NEWS_URL=https://staging.pbe400.org

# Observability (7a-3c / OFC-300 — provision-observability.sh). Where Cloud
# Monitoring emails the sign-in-denial-burst alert. Cloud Monitoring delivers this
# itself; Book has no mail wiring and is not involved. Not a secret. A prod.env
# would point this at whoever watches production.
ALERT_EMAIL=fthiess@gmail.com

# The Mixpanel project token for the staging tier (D138/D139 — the console project
# is named "PBE-Staging"; D138 calls it Mixpanel-Staging). A Mixpanel token is a
# publishable client-side identifier, not a secret, so it belongs in this public
# repo. Injected into the web build via $GITHUB_ENV (vite.config reads
# BOOK_MIXPANEL_TOKEN).
#
# Unlike BOOK_PBE_NEWS_URL above, an unset build defaults to **empty**, which
# disables analytics rather than falling back to production — so local dev and CI
# (which builds and drives the real bundle under Playwright) can never emit events
# into the live members' dataset. The production token lands with the production
# deploy path at cutover; see CUTOVER-PLAN.md.
BOOK_MIXPANEL_TOKEN=ec05216fbd33b0caa87779d8292bf9fc
