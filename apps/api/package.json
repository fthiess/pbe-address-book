{
  "name": "@pbe/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "dev": "tsx watch src/index.dev.ts",
    "start": "node dist/server.js",
    "restore": "tsx src/tools/restore.ts",
    "prepare:uat-photos": "tsx src/tools/prepare-uat-photos.ts",
    "genesis:convert": "tsx src/tools/csv-to-snapshot.ts",
    "genesis:headshots": "tsx src/tools/load-headshots.ts",
    "backfill:full-name": "tsx src/tools/backfill-full-name.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@pbe/shared": "*",
    "fastify": "^5.12.5",
    "firebase-admin": "^14.4.0",
    "jose": "^6.2.12",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.7"
  }
}
